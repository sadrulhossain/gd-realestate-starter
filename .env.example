# Copy to .env (cp .env.example .env, then set APP_KEY) and change every "change-me".
COMPOSE_PROJECT_NAME=gd-realestate-starter
COMPOSE_PROFILES=dev
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_DOMAIN=gd-realestate-starter.localhost

# Pins (source of truth: docs/VERSIONS.md; checked by `sh scripts/check-versions.sh`)
PHP_VERSION=8.5.13
LARAVEL_VERSION=13.29.0
COMPOSER_VERSION=2.11.2
NODE_VERSION=24.22.3
NEXT_VERSION=16.4.6
NGINX_VERSION=1.30.8
PHPREDIS_VERSION=6.3.0
POSTGRES_VERSION=18.7
REDIS_VERSION=8.10.3
MAILPIT_VERSION=v1.33.1
VITE_VERSION=8.3.8
REACT_VERSION=19.3.1

# Ports (28xxx block). Published: nginx, postgres, redis, mailpit. Dev ports are internal to the node container.
NGINX_HTTP_PORT=28080
POSTGRES_PORT=28432
REDIS_PORT=28379
MAILPIT_SMTP_PORT=28025
MAILPIT_UI_PORT=28026
PORTAL_DEV_PORT=28300
ADMIN_DEV_PORT=28301

POSTGRES_DB=gd_realestate
POSTGRES_USER=gd_realestate
POSTGRES_PASSWORD=change-me

REDIS_USER=gd_realestate
REDIS_PASSWORD=change-me

LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_SUPPORTED=en

# Uploads (mount point inside php + nginx containers; max size in MB)
UPLOADS_CONTAINER_PATH=/var/www/uploads
UPLOADS_MAX_MB=5

# Public origin of the portal (canonical URLs, Open Graph, sitemap). Production: https://your-domain
SITE_URL=http://gd-realestate-starter.localhost:28080

# Portal revalidation webhook (empty URL = disabled) and contact form fallback recipient
# Dev: PORTAL_REVALIDATE_URL=http://node:28300/api/revalidate (the portal's route, same secret both sides)
PORTAL_REVALIDATE_URL=
PORTAL_REVALIDATE_SECRET=change-me
CONTACT_NOTIFY_TO=
# Optional rental management module (tenants, leases, rent, maintenance). false switches it off.
RENTALS_ENABLED=true

# Admin SPA OAuth client id (must equal OAUTH_ADMIN_CLIENT_ID in api/.env)
OAUTH_ADMIN_CLIENT_ID=e98a6a07-2975-4f52-941e-d9b6b27eb580
